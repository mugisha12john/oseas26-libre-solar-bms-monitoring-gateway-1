{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-solar.org/schemas/event/1.0",
  "title": "Libre Solar BMS event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "battery_id", "site_id", "timestamp", "type", "severity", "message"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "battery_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "type": {"enum": ["LOW_SOC", "HIGH_TEMPERATURE", "LOW_TEMPERATURE", "CELL_IMBALANCE", "OVER_VOLTAGE", "UNDER_VOLTAGE", "OVER_CURRENT", "BMS_FAULT"]},
    "severity": {"enum": ["INFO", "WARNING", "CRITICAL"]},
    "message": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1}
  }
}

