{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-solar.org/schemas/status/1.0",
  "title": "Libre Solar BMS availability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "battery_id",
    "site_id",
    "status",
    "timestamp",
    "last_seen"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "battery_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["online", "offline"] },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
