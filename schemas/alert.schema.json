{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-solar.org/schemas/alert/1.0",
  "title": "Libre Solar actionable BMS alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "battery_id",
    "severity",
    "rule_id",
    "title",
    "evidence",
    "explanation",
    "recommended_checks",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "alert_id": { "type": "string", "minLength": 1 },
    "battery_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["INFO", "WARNING", "CRITICAL"] },
    "rule_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit", "threshold"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number" },
        "trend": { "enum": ["INCREASING", "DECREASING", "STABLE"] },
        "affected_cell": { "type": "integer", "minimum": 1 }
      }
    },
    "explanation": { "type": "string", "minLength": 1 },
    "recommended_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
